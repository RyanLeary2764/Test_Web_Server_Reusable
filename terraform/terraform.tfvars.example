aws_region          = "us-east-1"
allowed_cidr        = "203.0.113.10/32" # Replace with your public IPv4 address.
ssh_public_key_path = "~/.ssh/id_ed25519.pub"

# Enable GitHub Actions deployment:
github_repository = "RyanLeary2764/Test_Web_Server_Reusable"
